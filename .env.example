# Copy this file to `.dev.vars` (gitignored) for local `wrangler pages dev`.
# In production these are set with `wrangler pages secret put <NAME>` — see
# README「環境變數設定」.

# ---------------------------------------------------------------------------
# REQUIRED — encrypts each user's Jira API token before it is stored in D1.
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing this value makes every stored token unreadable and everyone will
# have to re-enter their Jira token, so keep it safe and don't rotate casually.
# ---------------------------------------------------------------------------
ENCRYPTION_KEY=paste_a_32_byte_base64_key_here

# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY — who you are pretending to be when Cloudflare Access
# isn't in front of the site. Ignored in production once CF_ACCESS_* are set.
# ---------------------------------------------------------------------------
DEV_USER_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# PRODUCTION — set both to require a valid Cloudflare Access login. Until they
# are set, the app runs unauthenticated and shows a warning banner.
#   CF_ACCESS_TEAM_DOMAIN: your Zero Trust team domain
#   CF_ACCESS_AUD:         the Access application's Application Audience tag
# ---------------------------------------------------------------------------
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=0123456789abcdef0123456789abcdef0123456789abcdef

# ---------------------------------------------------------------------------
# OPTIONAL — an org-wide Jira connection used only for people who have not set
# up their own in the UI. Leave unset if everyone connects their own account.
# ---------------------------------------------------------------------------
# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_EMAIL=service-account@example.com
# JIRA_API_TOKEN=your_jira_api_token_here

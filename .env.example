# Copy this file to `.dev.vars` (gitignored) for local `wrangler pages dev`
# development. In production these are NOT set via .env — they are set with
# `wrangler pages secret put <NAME>` (see README "環境變數設定").
#
# JIRA_BASE_URL is not secret and also lives in wrangler.toml's [vars]; it is
# only listed here so local dev has everything in one file.

# Your Jira Cloud site base URL (no trailing slash)
JIRA_BASE_URL=https://your-domain.atlassian.net

# The Atlassian account email used to generate the API token below
JIRA_EMAIL=you@example.com

# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN=your_jira_api_token_here
